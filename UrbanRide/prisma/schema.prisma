generator client {
  provider     = "prisma-client"
  output       = "../backend/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum RideStatus {
  REQUESTED
  SEARCHING
  ASSIGNED
  DRIVER_ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CancellationReason {
  CUSTOMER
  RIDER
  SYSTEM
}

model Ride {
  id         String     @id @default(cuid())
  customerId String
  corporateAccountId String?
  riderId    String?
  status     RideStatus @default(REQUESTED)

  pickupAddress   String
  pickupLatitude  Decimal @db.Decimal(10, 7)
  pickupLongitude Decimal @db.Decimal(10, 7)

  dropAddress   String
  dropLatitude  Decimal @db.Decimal(10, 7)
  dropLongitude Decimal @db.Decimal(10, 7)

  estimatedDistance Decimal? @db.Decimal(10, 2)
  estimatedFare     Decimal? @db.Decimal(10, 2)
  finalFare         Decimal? @db.Decimal(10, 2)

  cancellationReason CancellationReason?
  cancelledAt        DateTime?

  requestedAt DateTime  @default(now())
  assignedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  corporateAccount CorporateAccount? @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
  payment Payment?

  @@index([customerId])
  @@index([riderId])
  @@index([corporateAccountId])
  @@index([status])
  @@index([requestedAt])
}

model RiderDeviceToken {
  id        String   @id @default(cuid())
  riderId   String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([riderId])

}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

model Payment {
  id     String        @id @default(cuid())
  rideId String        @unique
  amount Decimal       @db.Decimal(10, 2)
  status PaymentStatus @default(PENDING)

  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique
  razorpaySignature String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

    ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
}

model CorporateAccount {
  id           String             @id @default(cuid())
  name         String
  billingEmail String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  employees CorporateEmployee[]
  rides     Ride[]

  @@index([name])
}

model CorporateEmployee {
  id                String          @id @default(cuid())
  corporateAccountId String
  name              String
  email             String          @unique
  phone             String?
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  corporateAccount CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)

  @@index([corporateAccountId])
  @@index([active])
}










