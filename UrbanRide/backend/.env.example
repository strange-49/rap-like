# Backend-only variables. Keep actual values outside version control.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ride_platform?schema=public"
PORT=3000
NODE_ENV=development

# Firebase Admin SDK
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Razorpay
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Twilio
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
# Communication
SMS_PROVIDER="mock"

# Optional horizontal-scaling services. In production shared auth/OTP limits fail closed without Redis.
# REDIS_URL=redis://localhost:6379
# QUEUE_ENABLED=true
# RUN_WORKER=true
# MAINTENANCE_INTERVAL_SECONDS=60
# BULLMQ_CONCURRENCY=5
# BULLMQ_DRAIN_DELAY_SECONDS=15
# BULLMQ_STALLED_INTERVAL_MS=60000
# REDIS_SHARE_RIDER_LOCATIONS=true
# INSTANCE_ID=api-1
# AUTH_SESSION_SECRET=<32-or-more-random-characters; identical across production instances>
# TRUST_PROXY=false
# CORS_ALLOWED_ORIGINS=https://customer.example,https://admin.example
# RATE_LIMIT_DISABLED=false
# DISPATCH_RADIUS_KM=10
# ROUTING_TIMEOUT_MS=4000
# GEOCODER_TIMEOUT_MS=4000
# GEOCODER_MIN_INTERVAL_MS=1000
# RAZORPAY_MANUAL_CAPTURE=false
# ALLOW_SEED_IN_PRODUCTION=false
# SEED_RESET_PASSWORDS=false
